{
  "name": "lets-rag-docs-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "productName": "Let's RAG Docs",
  "description": "Placeholder desktop shell for lets-rag-docs. Opens one neutral window and does nothing else: no backend, no IPC, no network. The product direction is still open.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke": "npm run build && RAG_DOCS_SMOKE=1 electron .",
    "start": "npm run build && electron ."
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "typescript": "5.9.3",
    "@types/node": "24.19.2"
  }
}
